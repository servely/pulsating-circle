{
  "name": "@crystal-creations/pulsating-circle",
  "version": "4.0.0-beta.1",
  "type": "module",
  "author": "Servely UG (haftungsbeschränkt)",
  "license": "MIT",
  "description": "A pulsating circle wrapped in a Vue component based on a [codepen](https://codepen.io/eereeska/pen/gOPdBZg) by eereeska",
  "scripts": {
    "lint": "eslint src/**/* --max-warnings 0",
    "test:release-notes": "node scripts/check-release-notes.ts",
    "semantic-release": "semantic-release",
    "build": "vite build",
    "dev": "vite",
    "serve": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "commitlint": "commitlint"
  },
  "keywords": [
    "circle",
    "pulsating",
    "animation"
  ],
  "homepage": "https://github.com/servely/pulsating-circle",
  "bugs": "https://github.com/servely/pulsating-circle/issues",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./styles": {
      "default": "./dist/style.css"
    },
    "./nuxt": {
      "types": "./src/nuxt.ts",
      "default": "./src/nuxt.ts"
    }
  },
  "repository": "https://github.com/servely/pulsating-circle",
  "peerDependencies": {
    "vue": "^3.0.0",
    "vuetify": "^3.5.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@nuxt/kit": "4.6.4",
    "@nuxtjs/eslint-config-typescript": "12.1.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-links": "10.6.7",
    "@storybook/vue3": "10.6.7",
    "@storybook/vue3-vite": "10.6.7",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "chromatic": "18.14.6",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-storybook": "10.6.7",
    "eslint-plugin-vue": "9.21.1",
    "prettier": "3.10.1",
    "sass": "1.70.0",
    "semantic-release": "26.0.1",
    "storybook": "10.6.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2",
    "vue": "3.5.45",
    "vuetify": "3.13.8"
  }
}
